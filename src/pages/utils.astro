---
import Layout from "@layouts/DefaultLayout.astro";
import Section from "@components/Section.astro";

import QRCodeGenerator from "src/utils/qrcode";
import PasswordGenerator from "src/utils/password";
---

<style>
	.section-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	/* Util page specific global styles */
	:global(.util-card) {
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(12px);
		border-radius: var(--radius-md);
		border: 1px solid var(--bg-border);
		padding: 2rem;
		box-shadow: var(--shadow-md);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	:global(.util-input) {
		width: 100%;
		padding: 0.75rem;
		border-radius: 8px;
		border: 1px solid var(--bg-border);
		background: rgba(255, 255, 255, 0.9);
		font-size: 1rem;
		color: var(--text-main);
	}

	:global(.qr-container) {
		display: flex;
		justify-content: center;
		padding: 1rem;
		background: white;
		border-radius: 8px;
	}

	:global(.button-group) {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	:global(.qr-field),
	:global(.qr-fields) {
		display: grid;
		gap: 0.65rem;
		min-width: 0;
	}

	:global(.qr-fields) {
		gap: 1rem;
	}

	:global(.qr-field > label) {
		font-weight: 600;
	}

	:global(.qr-description) {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
	}

	:global(textarea.util-input) {
		font-family: inherit;
		resize: vertical;
	}

	:global(.qr-heading) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	:global(.qr-heading h2) {
		margin: 0;
	}

	:global(.qr-heading + .qr-description) {
		margin-top: 0.5rem;
	}

	:global(.qr-type) {
		padding: 0.3rem 0.4rem;
		border: 1px solid var(--bg-border);
		border-radius: 6px;
		background: transparent;
		color: var(--text-secondary);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
	}

	:global(.qr-type:focus-visible) {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	:global(.qr-resolution) {
		display: flex;
		gap: 1rem;
		align-items: center;
	}

	:global(.qr-resolution input[type="range"]) {
		flex: 1;
		min-width: 0;
		accent-color: var(--primary);
	}

	:global(.qr-resolution input[type="number"]) {
		width: 6rem;
	}

	:global(.qr-empty) {
		margin: 0;
		padding: 2rem 1rem;
		text-align: center;
		background: var(--bg-body);
		border: 1px dashed var(--bg-border);
		border-radius: 8px;
		color: var(--text-secondary);
	}

	:global(.qr-route) {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 1rem;
		max-height: 6rem;
		overflow: auto;
	}

	:global(.util-btn:disabled) {
		opacity: 0.45;
		cursor: not-allowed;
	}

	@media (max-width: 600px) {
		:global(.util-card) {
			padding: 1rem;
		}
	}

	:global(.util-btn) {
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		border: none;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s;
	}

	:global(.util-btn.primary) {
		background: var(--primary);
		color: white;
	}

	:global(.util-btn.secondary) {
		background: var(--bg-border);
		color: var(--text-main);
	}

	:global(.options-group) {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	:global(.radio-option) {
		display: flex;
		gap: 0.5rem;
		align-items: flex-start;
	}

	:global(.result-container) {
		background: var(--bg-body);
		padding: 1rem;
		border-radius: 8px;
		border: 1px solid var(--bg-border);
	}

	:global(.result-row) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	:global(.result-text) {
		font-family: monospace;
		word-break: break-all;
		font-size: 1.1em;
		color: var(--primary);
		margin: 0;
	}

	:global(.util-btn.small) {
		padding: 0.5rem 1rem;
		font-size: 0.9em;
	}

	:global(.checkbox-row) {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	@media screen and (max-device-width: 768px) {
		.section-grid {
			justify-items: center;
		}
	}
</style>

<Layout
	title="Utils"
	pageTitle="Gregory | Utils"
	description="Here is a live QR Code generator and a password generator :)"
>
	<main id="main" class="sections-container">
		<Section id="description">
			Here is a live QR Code generator and a password generator :)
		</Section>

		<Section id="qrcode">
			<QRCodeGenerator client:only="react">
				<div class="util-card">
					<h2>QR Code Generator</h2>
					<p>Loading QR widget...</p>
				</div>
			</QRCodeGenerator>
		</Section>

		<Section id="password">
			<PasswordGenerator client:only="react">
				<div class="util-card">
					<h2>Password Generator</h2>
					<p>Loading password widget...</p>
				</div>
			</PasswordGenerator>
		</Section>
	</main>
</Layout>
